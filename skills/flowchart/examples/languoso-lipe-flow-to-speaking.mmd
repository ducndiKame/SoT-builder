flowchart TD
  %% ============================================================
  %% 3 PHÂN ĐOẠN NỐI TIẾP:
  %%  🚩 GATE 2 remote keys: enable_lipe_learning (bật/tắt) + lipe_learning_levels (level nào được học). Không thỏa → luồng CŨ (không LIPE)
  %%  (A) SCENARIO DETAIL — Figma 7786-70341 → Situation(AI gen L1) · Mission(AI gen L1) · Choose · Loading
  %%  (B) LIPE LEARNING   — Figma 7593-19658 → Lecture(TẠO THREADS + fallback L1→EN) · Interactive-Practice
  %%  (C) AI SPEAKING     — ĐI LẠI LUỒNG CŨ (đã triển khai) · 3 đổi: TTS 0.9× · hint auto-show · mascot gộp 1 câu
  %% ============================================================

  subgraph SGA["(A) SCENARIO DETAIL — Figma 7786-70341"]
    HOME(["Home — chọn 1 lesson"]):::screen
    HOME --> A1["GET lesson_detail (v2) — situation · mission · learnBlock · isBeginner · overall(14 sub-DIM)"]:::api
    A1 --> D1{"lesson_detail OK?"}:::dec
    D1 -->|"❌ ERR107·403 LOCKED"| E1["Error sheet: bài chưa mở"]:::stop
    D1 -->|"❌ net·5xx (ERR17·504)"| E1b["toast + Retry"]:::fail
    E1b -.->|retry| A1
    D1 -->|"✅"| GATE{"🚩 enable_lipe_learning ON & lesson.level ∈ lipe_learning_levels?"}:::dec
    GATE -->|"❌ OFF · hoặc level KHÔNG nằm trong list"| OLD(["Luồng CŨ — AI Speaking, KHÔNG học LIPE (đã triển khai)"]):::exam
    GATE -->|"✅ thỏa cả 2 key"| ASIT["🤖 AI gen → dịch bối cảnh (situation) sang L1 (tiếng mẹ đẻ user)"]:::api
    ASIT --> DSIT{"AI gen L1 OK?"}:::dec
    DSIT -->|"❌ AI gen FAIL"| ESIT["auto retry 3× · vẫn fail → AUTO fallback EN gốc"]:::fail
    ESIT -.->|"retry (≤3)"| ASIT
    DSIT -->|"✅ L1"| SIT
    ESIT --> SIT
    SIT(["① SITUATION — 'First Day at the Office' (L1 nếu OK · EN nếu fallback)"]):::screen

    SIT -->|"Continue →"| AMIS["🤖 AI gen → dịch 3 nhiệm vụ (mission) sang L1"]:::api
    AMIS --> DMIS{"AI gen L1 OK?"}:::dec
    DMIS -->|"❌ AI gen FAIL"| EMIS["auto retry 3× · vẫn fail → AUTO fallback EN gốc"]:::fail
    EMIS -.->|"retry (≤3)"| AMIS
    DMIS -->|"✅ L1"| MIS
    EMIS --> MIS
    MIS(["② MISSION — 3 nhiệm vụ (L1 nếu OK · EN nếu fallback)"]):::screen

    MIS -->|"Continue →"| CH{"③ CHOOSE — 'Want to learn a few words first, or start speaking now?'"}:::dec
    CH -->|"Learn first"| LOAD
    CH -->|"Start speaking"| LOAD

    LOAD(["④ LOADING YOUR LESSON… (>5s → 'Almost there…')"]):::screen
    LOAD --> ALD["Chuẩn bị bài — prefetch assets (TTS 0.9× · ảnh · pool I/P) · KHÔNG tạo threads ở đây"]:::api
    ALD --> DLD{"load lesson OK?"}:::dec
    DLD -->|"❌ net·5xx"| ELD["Sheet 'Couldn't Load Lesson' [Try again] [Back to Home] · net rớt → 'Lost Connection' [Try again]"]:::fail
    ELD -.->|Try again| ALD
    DLD -->|"✅"| ROUTE{"đã chọn ở ③?"}:::dec
    ROUTE -->|"Learn first"| L
    ROUTE -->|"Start speaking"| SPK
  end

  subgraph SGB["(B) LIPE LEARNING — Figma 7593-19658"]
    L(["⑤ LECTURE — dạy 5 vocab + 3 mẫu câu"]):::screen
    L --> AC["⭐ POST createConversation / tạo threads (v2) — TẠO Ở LECTURE (AI Speaking dùng lại)"]:::api
    AC --> DC{"threads OK?"}:::dec
    DC -->|"❌ ERR108·401 refresh / net·5xx"| ECb["toast + Retry"]:::fail
    ECb -.->|retry| AC
    DC -->|"✅ conversationId (giữ lại)"| AL["Render lecture ← learnBlock (vocab/phrase detail · TTS chậm 0.9×)"]:::api
    AL --> DL1{"item có L1 (tiếng mẹ đẻ) trong data?"}:::dec
    DL1 -->|"❌ thiếu L1"| EL1["AUTO fallback → hiển thị EN (l1Fallback='en')"]:::alt
    DL1 -->|"✅ có L1"| ALok["hiển thị nghĩa/def/dịch bằng L1"]:::alt
    EL1 --> IP
    ALok --> IP

    IP(["⑥ INTERACTIVE · PRACTICE (8 câu, 1/item)"]):::screen
    IP --> AIP["GET interactive_practice (⚠️ API MỚI) — POOL từ QUIZ BANK LIPE"]:::api
    AIP --> DIP{"OK?"}:::dec
    DIP -->|"❌ net·5xx"| EIP["toast + Retry"]:::fail
    EIP -.->|retry| AIP
    DIP -->|"✅ pool"| BIP["BỐC I/P theo TIER = tỉ lệ theo OVERALL 14 sub-DIM: Yếu 5:3:0 · TB 3:3:2 · Khá 1:3:4"]:::api
    BIP --> IPQ["Hiện câu i (form theo tier)"]:::api
    IPQ --> IPok{"đúng?"}:::dec
    IPok -->|"❌ sai → feedback tức thì + L1"| IPr["retry TẠI CHỖ (sai ≥K → hạ 1 tier)"]:::alt
    IPr -.->|thử lại| IPQ
    IPok -->|"✅ (phát âm: chỉ mobile, KHÔNG gửi chấm)"| IPmore{"còn item? (phải ĐÚNG mới next)"}:::dec
    IPmore -->|"còn"| IPQ
    IPmore -->|"hết 8"| SPK
  end

  subgraph SGC["(C) AI SPEAKING"]
    SPK["⑦ E · AI SPEAKING<br/>➡️ ĐI LẠI LUỒNG CŨ (đã triển khai) · ⚡ 3 ĐỔI: (1) TTS 0.9× (2) hint AUTO hiện ngay sau khi mascot nói xong (bỏ chờ 3s im lặng) (3) mascot nói GỘP 1 CÂU / 1 lần TTS (bỏ tách nhiều câu riêng)<br/>Learn first: dùng lại conversationId tạo ở Lecture · Start speaking: AI Speaking cũ tự tạo threads<br/>SSE streamSession + upload audio · mission x/3 · chấm E = LOGIC CŨ · Summary → nextLesson"]:::exam
  end

  %% ---------- 1 nguồn quiz cho I/P ----------
  QB{{"QUIZ BANK LIPE — pool/lesson (DB × 8 hình thái). CHỈ I/P bốc (E = AI Speaking, không đọc bank)"}}:::note
  QB -.->|pool| AIP
  BIP -.->|ghi state per-item| QB

  %% ===== KILL/HIDE TẠI TỪNG NODE (chỉ phân đoạn A + B) =====
  SIT -.->|"🟡 hide"| SITh["Giữ vị trí + kết quả AI gen L1 → tiếp"]:::hide
  SIT -.->|"🔴 kill"| SITk["Vào lại từ Situation (gen lại L1 nếu cần)"]:::kill
  MIS -.->|"🟡 hide"| MISh["Giữ trạng thái → tiếp"]:::hide
  MIS -.->|"🔴 kill"| MISk["Vào lại từ đầu lesson"]:::kill
  LOAD -.->|"🟡 hide"| LOADh["Giữ lựa chọn ③ → tiếp tục load"]:::hide
  LOAD -.->|"🔴 kill"| LOADk["Vào lại từ lesson (CHƯA tạo thread ở bước này)"]:::kill
  L -.->|"🟡 hide"| Lh["Dừng TTS · giữ conversationId + slide → tiếp"]:::hide
  L -.->|"🔴 kill"| Lk["⚠️ Thread MỒ CÔI (đã createConversation ở Lecture) → reuse/tạo lại + dọn · lecture về đầu"]:::kill
  IP -.->|"🟡 hide (dở câu i/8)"| IPh["Pause · giữ index i + câu đã đúng (quiz-bank) → mở lại đúng câu i"]:::hide
  IP -.->|"🔴 kill (dở câu i/8)"| IPk["⛔ v5: resume câu i · v6: làm lại I/P từ câu 1"]:::kill

  classDef screen fill:#0C3355,color:#ffffff,stroke:#07223B,stroke-width:1px;
  classDef exam fill:#7A1F5C,color:#ffffff,stroke:#5A1444,stroke-width:1.5px;
  classDef api fill:#EAF3FC,color:#0C3355,stroke:#3EA5EF,stroke-width:1px;
  classDef dec fill:#fff7e6,color:#5b3d10,stroke:#c67f1e,stroke-width:1px;
  classDef fail fill:#fcecec,color:#a5261e,stroke:#c0392b,stroke-width:1px;
  classDef alt fill:#eef0f2,color:#41505f,stroke:#8a94a0,stroke-width:1px;
  classDef stop fill:#f6d7d4,color:#7a1a12,stroke:#b3261e,stroke-width:1.5px;
  classDef note fill:#e6f4ea,color:#15803d,stroke:#7fbf98,stroke-width:1.5px,stroke-dasharray:4 3;
  classDef hide fill:#FFF7E6,color:#8a5a06,stroke:#E0A94A,stroke-width:1px,stroke-dasharray:4 3;
  classDef kill fill:#FDECEC,color:#a5261e,stroke:#D08A85,stroke-width:1px,stroke-dasharray:4 3;
