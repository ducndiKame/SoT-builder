    ["icon/success", "success/600", "success/400", "Success icon"],
    ["icon/warning", "warning/600", "warning/400", "Warning icon"],
    ["icon/error", "error/600", "error/400", "Error icon"],
    ["icon/info", "info/600", "info/400", "Info icon"],
    ["border/default", "neutral/300", "neutral/600", "Divider, card outline (decorative)"],
    ["border/strong", "neutral/400", "neutral/500", "Input outline, control boundary"],
    ["border/subtle", "neutral/100", "neutral/800", "Hairline separator"],
    ["border/disabled", "neutral/200", "neutral/700", "Disabled control outline"],
    ["border/brand", "primary/400", "primary/500", "Selected card, brand outline"],
    ["border/success", "success/500", "success/600", "Success outline"],
    ["border/warning", "warning/500", "warning/600", "Warning outline"],
    ["border/error", "error/500", "error/600", "Invalid field outline"],
    ["border/info", "info/500", "info/600", "Info outline"],
    ["border/focus", "primary/400", "primary/400", "Focus ring"],
    ["action/primary/default", "primary/400", "primary/400", "Primary button fill"],
    ["action/primary/hover", "primary/500", "primary/300", "Primary button hover"],
    ["action/primary/pressed", "primary/600", "primary/200", "Primary button pressed"],
