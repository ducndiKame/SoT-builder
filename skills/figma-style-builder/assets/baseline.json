  "code_syntax": {
    "_note": "{group}, {name} lấy từ tên token. WEB dùng kebab, iOS camelCase, ANDROID snake_case.",
    "COLOR": { "WEB": "var(--color-{kebab})", "iOS": "Color.{camel}", "ANDROID": "R.color.{snake}" },
    "FLOAT": { "WEB": "var(--{kebab})", "iOS": "Dimension.{camel}", "ANDROID": "R.dimen.{snake}" }
  },

  "deviations_from_fitagain": [
    "Scope: FitAgain để ALL_SCOPES cho cả 120 biến. Ở đây Primitives có scope rỗng (ẩn khỏi picker, không publish) và Semantic có scope theo nhóm, để designer không bind nhầm Primitive vào UI.",
    "Code syntax: FitAgain chưa có. Ở đây gắn WEB / iOS / ANDROID cho mọi biến.",
    "Description: mỗi biến Semantic có câu 'dùng ở đâu', hiện ngay trong picker.",
    "Contrast: FitAgain có 5 lỗi AA (CTA trắng trên primary/400 2.89:1, text/tertiary 2.55:1, border/focus 2.89:1…). Ở đây cổng contrast tự dời bậc trước khi ghi vào Figma; designer được chọn giữ màu và ghi ngoại lệ.",
    "Code/*: FitAgain dùng Be Vietnam Pro (không phải mono). Ở đây Code/* dùng font mono, hoặc bỏ nếu dự án không cần.",
    "Dimension (spacing, radius): FitAgain chưa có biến. Ở đây là tuỳ chọn."
  ]
}
