{
  "_about": "Khung chuẩn của figma-style-builder, trích từ FitAgain (Figma D3U7RV0Wi8k05AbY8faRNj, đọc qua Variables API ngày 2026-11-04). Tên, nhóm, số bậc, thang chữ giữ y FitAgain để mọi dự án đồng nhất. Các chỗ cố ý lệch FitAgain nằm ở 'deviations_from_fitagain'. Sửa file này = đổi chuẩn cho mọi dự án sau; sửa tokens.json của một dự án = chỉ đổi dự án đó.",
  "steps": [50, 100, 200, 300, 400, 500, 600, 700, 800, 900],
  "ramps": {
    "primary": ["#F3F0FF", "#E6DFFF", "#CFC4FF", "#AB99FF", "#9F85FF", "#8264E6", "#694EC8", "#523AA8", "#3D2887", "#2A1964"],
    "neutral": ["#F9FAFB", "#F3F4F6", "#E5E7EB", "#D1D5DB", "#9CA3AF", "#6B7280", "#4B5563", "#374151", "#1F2937", "#111827"],
    "success": ["#F6FCF3", "#EBF8E2", "#D3F1C1", "#B0E58F", "#85D751", "#65BF2C", "#4F9522", "#40781C", "#356317", "#2C5313"],
    "warning": ["#FFFBEB", "#FEF3C7", "#FDE68A", "#FCD34D", "#FBBF24", "#F59E0B", "#D97706", "#B45309", "#92400E", "#78350F"],
    "error": ["#FEF2F2", "#FEE2E2", "#FECACA", "#FCA5A5", "#F87171", "#EF4444", "#DC2626", "#B91C1C", "#991B1B", "#7F1D1D"],
    "info": ["#EFF6FF", "#DBEAFE", "#BFDBFE", "#93C5FD", "#60A5FA", "#3B82F6", "#2563EB", "#1D4ED8", "#1E40AF", "#1E3A8A"]
  },
  "ramp_order": ["primary", "neutral", "success", "warning", "error", "info"],
  "ramp_profile": "primary",
  "base": { "white": "#FFFFFF", "black": "#000000" },

  "semantic": [
