    ["action/secondary/default", "neutral/100", "neutral/700", "Secondary button fill"],
    ["action/secondary/hover", "neutral/200", "neutral/600", "Secondary button hover"],
    ["action/secondary/pressed", "neutral/300", "neutral/500", "Secondary button pressed"],
    ["action/secondary/disabled", "neutral/50", "neutral/800", "Secondary button disabled"],
    ["action/secondary/foreground", "neutral/900", "white", "Label and icon on secondary button"],
    ["feedback/success/bg", "success/50", "success/900", "Success banner background"],
    ["feedback/success/fg", "success/700", "success/300", "Success banner text and icon"],
    ["feedback/warning/bg", "warning/50", "warning/900", "Warning banner background"],
    ["feedback/warning/fg", "warning/700", "warning/300", "Warning banner text and icon"],
    ["feedback/error/bg", "error/50", "error/900", "Error banner background"],
    ["feedback/error/fg", "error/700", "error/300", "Error banner text and icon"],
    ["feedback/info/bg", "info/50", "info/900", "Info banner background"],
    ["feedback/info/fg", "info/700", "info/300", "Info banner text and icon"]
