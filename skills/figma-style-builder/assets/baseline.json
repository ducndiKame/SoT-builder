  "secondary": {
    "_note": "Chỉ dùng khi dự án có màu secondary. Ramp tên 'secondary' nằm trong Primitives; token Semantic tên 'accent' vì chữ 'secondary' trong khung đã mang nghĩa thứ bậc (text/secondary = chữ phụ, action/secondary = nút phụ xám). use = 'accent': chỉ thêm nhóm accent. use = 'accent+button': thêm nhóm accent và chuyển action/secondary/* từ xám sang ramp secondary.",
    "ramp": "secondary",
    "accent": {
      "semantic": [
        ["bg/accent", "secondary/400", "secondary/500", "Accent-filled region (badge, highlight); text on it uses text/on-accent"],
        ["bg/accent-subtle", "secondary/50", "secondary/900", "Tinted accent region, tag background"],
        ["text/accent", "secondary/600", "secondary/300", "Accent-coloured text"],
        ["text/on-accent", "white", "white", "Text on bg/accent"],
        ["icon/accent", "secondary/500", "secondary/400", "Accent icon"],
        ["border/accent", "secondary/400", "secondary/500", "Accent outline"]
      ],
      "gates": [
        ["text/accent", "bg/primary", 4.5, "fg", []],
        ["text/on-accent", "bg/accent", 4.5, "bg", []],
        ["icon/accent", "bg/primary", 3.0, "fg", []]
      ],
      "distinct": []
    },
    "button": {
      "semantic": [
        ["action/secondary/default", "secondary/400", "secondary/400", "Secondary button fill"],
        ["action/secondary/hover", "secondary/500", "secondary/300", "Secondary button hover"],
        ["action/secondary/pressed", "secondary/600", "secondary/200", "Secondary button pressed"],
        ["action/secondary/disabled", "secondary/200", "secondary/800", "Secondary button disabled"],
        ["action/secondary/foreground", "white", "white", "Label and icon on secondary button"]
      ],
      "gates": [
        ["action/secondary/foreground", "action/secondary/default", 4.5, "bg", ["action/secondary/hover", "action/secondary/pressed"]]
      ],
      "distinct": [["action/secondary/default", "action/secondary/hover", "action/secondary/pressed"]]
    }
  },

  "anchor": {
    "_note": "Token mang đúng màu brand. Khung trỏ chúng vào bậc 400 (FitAgain: brand nằm ở 400). Khi màu brand sinh ra rơi vào bậc khác (brand sáng như vàng → 200, brand đậm như navy → 700), các token này dời cùng số bậc để nút và nền brand đúng màu brand. Chỉ áp cho ramp sinh từ một mã hex, và chỉ dời giá trị đang trỏ vào chính ramp đó.",
    "step": 400,
    "primary": ["bg/brand", "border/brand", "border/focus", "action/primary/default", "action/primary/hover", "action/primary/pressed", "action/primary/disabled"],
    "secondary": ["bg/accent", "border/accent", "action/secondary/default", "action/secondary/hover", "action/secondary/pressed", "action/secondary/disabled"]
  },

  "on_color": {
    "_note": "Màu chữ/icon trên nền màu brand. 'white' (mặc định, như FitAgain) hoặc 'dark' (neutral/900, cho brand sáng như vàng, xanh mint). Token bị đổi theo từng màu brand.",
    "primary": ["text/on-brand", "action/primary/foreground"],
    "secondary": ["text/on-accent", "action/secondary/foreground"],
    "dark": "neutral/900"
  },

  "scopes": [
    ["action/*/foreground", ["TEXT_FILL", "SHAPE_FILL", "STROKE_COLOR"]],
    ["action/*", ["FRAME_FILL", "SHAPE_FILL"]],
    ["feedback/*/fg", ["TEXT_FILL", "SHAPE_FILL", "STROKE_COLOR"]],
    ["feedback/*", ["FRAME_FILL", "SHAPE_FILL"]],
    ["bg/*", ["FRAME_FILL", "SHAPE_FILL"]],
    ["surface/*", ["FRAME_FILL", "SHAPE_FILL"]],
    ["text/*", ["TEXT_FILL"]],
    ["icon/*", ["SHAPE_FILL", "STROKE_COLOR"]],
    ["border/*", ["STROKE_COLOR"]],
    ["spacing/*", ["GAP"]],
    ["radius/*", ["CORNER_RADIUS"]]
  ],

  "gates": {
    "_note": "[fg, bg, ngưỡng, bên được dời ('fg' | 'bg'), token dời theo cùng số bậc]. Áp cho mọi mode. Token disabled và border trang trí được miễn (WCAG 1.4.3 / 1.4.11).",
    "list": [
      ["text/primary", "bg/primary", 4.5, "fg", []],
      ["text/secondary", "bg/primary", 4.5, "fg", []],
      ["text/secondary", "surface/elevated", 4.5, "fg", []],
      ["text/tertiary", "bg/primary", 4.5, "fg", []],
      ["text/tertiary", "surface/elevated", 4.5, "fg", []],
      ["text/brand", "bg/primary", 4.5, "fg", []],
      ["text/success", "bg/primary", 4.5, "fg", []],
      ["text/warning", "bg/primary", 4.5, "fg", []],
      ["text/error", "bg/primary", 4.5, "fg", []],
      ["text/info", "bg/primary", 4.5, "fg", []],
      ["text/inverse", "bg/inverse", 4.5, "fg", []],
      ["text/on-brand", "bg/brand", 4.5, "bg", []],
      ["action/primary/foreground", "action/primary/default", 4.5, "bg", ["action/primary/hover", "action/primary/pressed"]],
      ["action/secondary/foreground", "action/secondary/default", 4.5, "fg", []],
      ["feedback/success/fg", "feedback/success/bg", 4.5, "fg", []],
      ["feedback/warning/fg", "feedback/warning/bg", 4.5, "fg", []],
      ["feedback/error/fg", "feedback/error/bg", 4.5, "fg", []],
      ["feedback/info/fg", "feedback/info/bg", 4.5, "fg", []],
      ["icon/primary", "bg/primary", 3.0, "fg", []],
      ["icon/secondary", "bg/primary", 3.0, "fg", []],
      ["icon/brand", "bg/primary", 3.0, "fg", []],
      ["icon/success", "bg/primary", 3.0, "fg", []],
      ["icon/warning", "bg/primary", 3.0, "fg", []],
      ["icon/error", "bg/primary", 3.0, "fg", []],
      ["icon/info", "bg/primary", 3.0, "fg", []],
      ["border/strong", "bg/primary", 3.0, "fg", []],
      ["border/error", "bg/primary", 3.0, "fg", []],
      ["border/focus", "bg/primary", 3.0, "fg", []]
    ],
    "distinct": [
      ["text/primary", "text/secondary", "text/tertiary"],
      ["action/primary/default", "action/primary/hover", "action/primary/pressed"]
    ]
  },

  "dimension": {
    "_note": "Tuỳ chọn (style-config.json → dimension). FitAgain chưa có collection này; spacing/radius chỉ nằm trong DesignSystem.md. Tên theo px để không mơ hồ giữa các dự án.",
