    ["feedback/success/fg", "success/700", "success/300", "Success banner text and icon"],
    ["feedback/warning/bg", "warning/50", "warning/900", "Warning banner background"],
    ["feedback/warning/fg", "warning/700", "warning/300", "Warning banner text and icon"],
    ["feedback/error/bg", "error/50", "error/900", "Error banner background"],
