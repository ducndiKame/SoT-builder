{
  "_about": "Khung chuẩn của figma-style-builder, trích từ FitAgain (Figma D3U7RV0Wi8k05AbY8faRNj, đọc qua Variables API ngày 2026-11-04). Tên, nhóm, số bậc, thang chữ giữ y FitAgain để mọi dự án đồng nhất. Các chỗ cố ý lệch FitAgain nằm ở 'deviations_from_fitagain'. Sửa file này = đổi chuẩn cho mọi dự án sau; sửa tokens.json của một dự án = chỉ đổi dự án đó.",
  "steps": [50, 100, 200, 300, 400, 500, 600, 700, 800, 900],
  "ramps": {
    "primary": ["#F3F0FF", "#E6DFFF", "#CFC4FF", "#AB99FF", "#9F85FF", "#8264E6", "#694EC8", "#523AA8", "#3D2887", "#2A1964"],
    "neutral": ["#F9FAFB", "#F3F4F6", "#E5E7EB", "#D1D5DB", "#9CA3AF", "#6B7280", "#4B5563", "#374151", "#1F2937", "#111827"],
    "success": ["#F6FCF3", "#EBF8E2", "#D3F1C1", "#B0E58F", "#85D751", "#65BF2C", "#4F9522", "#40781C", "#356317", "#2C5313"],
    "warning": ["#FFFBEB", "#FEF3C7", "#FDE68A", "#FCD34D", "#FBBF24", "#F59E0B", "#D97706", "#B45309", "#92400E", "#78350F"],
    "error": ["#FEF2F2", "#FEE2E2", "#FECACA", "#FCA5A5", "#F87171", "#EF4444", "#DC2626", "#B91C1C", "#991B1B", "#7F1D1D"],
    "info": ["#EFF6FF", "#DBEAFE", "#BFDBFE", "#93C5FD", "#60A5FA", "#3B82F6", "#2563EB", "#1D4ED8", "#1E40AF", "#1E3A8A"]
  },
  "ramp_order": ["primary", "neutral", "success", "warning", "error", "info"],
  "ramp_profile": "primary",
  "base": { "white": "#FFFFFF", "black": "#000000" },

  "semantic": [
    ["bg/primary", "white", "neutral/900", "Default page background"],
    ["bg/secondary", "neutral/50", "neutral/800", "Secondary page region"],
    ["bg/tertiary", "neutral/100", "neutral/700", "Tertiary region, grouped list background"],
    ["bg/inverse", "neutral/900", "white", "Inverse background (dark snackbar, tooltip)"],
    ["bg/brand", "primary/400", "primary/500", "Brand-filled region; text on it uses text/on-brand"],
    ["bg/brand-subtle", "primary/50", "primary/900", "Tinted brand region, selected row"],
    ["surface/default", "white", "neutral/900", "Card, sheet"],
    ["surface/elevated", "neutral/100", "neutral/800", "Screen background behind white cards"],
    ["surface/overlay", "white", "neutral/700", "Popover, menu"],
    ["surface/sunken", "neutral/50", "neutral/900", "Inset well, input background"],
    ["surface/disabled", "neutral/100", "neutral/800", "Disabled container"],
    ["text/primary", "neutral/900", "white", "Titles, body text"],
    ["text/secondary", "neutral/600", "neutral/300", "Supporting text"],
    ["text/tertiary", "neutral/400", "neutral/500", "Metadata, placeholder, eyebrow"],
    ["text/disabled", "neutral/300", "neutral/600", "Disabled text (exempt from contrast)"],
    ["text/inverse", "white", "neutral/900", "Text on bg/inverse"],
    ["text/brand", "primary/600", "primary/300", "Brand-coloured text and links"],
    ["text/success", "success/700", "success/400", "Success text"],
    ["text/warning", "warning/700", "warning/400", "Warning text"],
    ["text/error", "error/600", "error/400", "Error text, helper text of invalid field"],
    ["text/info", "info/700", "info/400", "Info text"],
    ["text/on-brand", "white", "white", "Text on bg/brand"],
    ["icon/primary", "neutral/900", "white", "Default icon"],
